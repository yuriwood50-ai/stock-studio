# 스톡 스튜디오 - API 열쇠 (본보기)
#
# 이 파일을 .env 로 복사한 뒤 = 뒤에 열쇠를 붙여넣으세요.
# .env 는 git에 올라가지 않습니다. 이 본보기만 올라갑니다.
#
# 값에 따옴표를 붙이지 마세요.
#   맞음   OPENAI_API_KEY=sk-proj-abc123
# OPENAI_API_KEY=
#
# 열쇠 하나로 둘 다 씁니다.
#   소재 목록 뽑기 — 글자 모델. 조직 신원 확인이 필요 없습니다
#   이미지 만들기  — gpt-image-2. **조직 신원 확인을 먼저 마쳐야 합니다**
#                    (OpenAI 개발자 콘솔에서). 안 하면 이미지 만들기만 막힙니다
#
# 모델 이름 · 품질 · 호출 한도는 설정.json 의 AI 항목에서 바꿉니다.

OPENAI_API_KEY=
